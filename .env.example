# Platform API Base URL (defaults to https://api.higgsfield.ai)
HF_API_BASE_URL=https://api.higgsfield.ai

# Optional: Add your OpenRouter API key for OpenRouter Video & Image generation (sk-or-v1-...)
OPENROUTER_API_KEY=

# Optional: Add your Higgsfield API key (id:secret)
HF_API_KEY=

# Optional: Vercel Blob read-write token for uploading custom media
OPEN_HIGGSFIELD_READ_WRITE_TOKEN=

